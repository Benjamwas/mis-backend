# Core
# Django
SECRET_KEY=

# Database — Postgres on Supabase or local.
# Preferred form:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sala
# Individual overrides (fallback when DATABASE_URL is empty):
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sala
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSLMODE=prefer
# Set to 1 to use SQLite for local quickstart/testing when Postgres is unavailable.
DB_SQLITE=0

ENVIRONMENT=development
DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# JWT
JWT_SIGNING_KEY=
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
JWT_ALGORITHM=HS256
AUTHSLUG_LIFETIME_HOURS=24

# Encryption (Fernet key used for sensitive field-at-rest encryption if enabled)
ENCRYPTION_KEY=

# Redis / Celery
REDIS_URL=redis://localhost:6379/0
CELERY_REDIS_URL=redis://localhost:6379/1
CELERY_BROKER_URL=redis://localhost:6379/1

# Supabase (Storag / RPC infra only; service role key must NEVER reach the frontend)
SUPABASE_URL=
SUPABASE_PUBLIC_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=sala-files

# Storage driver: local | supabase
STORAGE_DRIVER=local
MEDIA_ROOT=media

# Email / SMTP
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=SALA <no-reply@sala.example.com>

# SMS provider abstraction (configure whichever provider is licensed)
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
SMS_PROVIDER_URL=
SMS_PROVIDER_API_KEY=
SMS_PROVIDER_SENDER_ID=

# WhatsApp provider abstraction
WHATSAPP_PROVIDER=twilio
WHATSAPP_FROM_NUMBER=

# M-Pesa (Daraja API)
MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_PASSKEY=
MPESA_SHORTCODE=174379
MPESA_BUSINESS_SHORTCODE=174379
MPESA_CALLBACK_BASE_URL=http://localhost:8000
MPESA_INITIATOR_NAME=
MPESA_INITIATOR_PASSWORD=
MPESA_TILL_NUMBER=

# Rate limiting
LOGIN_FAILURE_THRESHOLD=5
LOGIN_LOCKOUT_SECONDS=300

# Initial super admin (seeded via management command)
INITIAL_SUPER_ADMIN_EMAIL=
INITIAL_SUPER_ADMIN_PASSWORD=